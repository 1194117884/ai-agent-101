{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-engineering-coach",
  "account_id": "7f3ff9c779a7536b3d0caca7a2ae9fd7",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "agent-knowledge" }],
  "r2_buckets": [{ "binding": "KNOWLEDGE_UPLOADS", "bucket_name": "agent-engineering-coach-uploads" }],
  "queues": {
    "producers": [{ "binding": "KNOWLEDGE_QUEUE", "queue": "agent-engineering-coach-knowledge" }],
    "consumers": [{ "queue": "agent-engineering-coach-knowledge", "max_batch_size": 1, "max_batch_timeout": 2, "max_retries": 3, "dead_letter_queue": "agent-engineering-coach-knowledge-dlq" }]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "agent-engineering-coach", "database_id": "fea74aa5-dc8e-49ef-8be5-a84393b1f394", "migrations_dir": "drizzle" }],
  "observability": { "enabled": true },
  "vars": {
    "GOOGLE_CLIENT_ID": "12332638349-bep7ppcc9ql08grliduhbpa2bjbc5aot.apps.googleusercontent.com",
    "AI_ADMIN_EMAILS": "qq1194117884@gmail.com",
    "KNOWLEDGE_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "KNOWLEDGE_VECTOR_PROVIDER": "cloudflare"
  }
}
