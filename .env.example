# Providers are attempted from left to right. Omit a provider to disable it.
AI_PROVIDER_ORDER=anthropic,openai,deepseek,openrouter

# Required when API keys are managed in the admin UI. Use a stable random value
# of at least 24 characters; changing it makes previously saved keys unreadable.
AI_KEY_ENCRYPTION_SECRET=replace_with_a_long_random_secret
# Optional dedicated signing secret. If omitted, the key encryption secret is
# domain-separated and reused for session signing.
AUTH_SESSION_SECRET=replace_with_a_different_long_random_secret
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Comma-separated Google account emails allowed to manage AI channels.
AI_ADMIN_EMAILS=

# Multiple keys: comma/semicolon/whitespace-separated, or a JSON array.
ANTHROPIC_API_KEYS=key_1,key_2
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEYS=key_1,key_2
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEYS=key_1,key_2
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEYS=key_1,key_2
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional endpoint overrides for compatible gateways or proxies:
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
